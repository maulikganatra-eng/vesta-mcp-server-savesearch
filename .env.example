# Copy this file to .env and fill in your values.
# Never commit .env to version control (already gitignored).
#
# This repo has no dotenv loader of its own (no `python-dotenv` dependency) --
# `.env` is not read automatically by `python -m vesta_saved_search.server` or
# by pytest. Export these into your shell (e.g. `export $(cat .env | xargs)`,
# or use direnv/.envrc) or pass them via `--env-file` if you containerize this
# server yourself. Everything below is an optional override; defaults are
# shown as comments and match what the code falls back to when unset.

# ── GuestSite SavedSearches API ─────────────────────────────────────────────

# Base URL of the GuestSite SavedSearches API, no trailing path segment.
# Defaults to dev -- production deploys must override this explicitly.
# GUESTSITE_SAVED_SEARCH_BASE_URL=https://www.dev.themls.com/GuestSiteApi

# ── Property-search server (step S4 / N7) ───────────────────────────────────

# Base URL of the property-search MCP server's plain-HTTP side (the
# `/internal/es-query` wire-level endpoint), with NO trailing path -- this
# server calls it as a server-to-server HTTP client, never as an MCP tool.
# Every update needs a fresh esQuery from here, including a plain rename.
# Defaults to the local dev port (6000) that server binds to; production
# deploys must override this to the real internal service address.
# PROPERTY_SEARCH_INTERNAL_URL=http://localhost:6000

# ── Saved-search proposal store (steps N5/N6/N9) ────────────────────────────

# How long a propose_saved_search / delete proposal survives before
# save_search / delete_saved_search must answer proposal_expired. Short by
# design -- see vesta_saved_search.proposals for why.
# SAVED_SEARCH_PROPOSAL_TTL_SECONDS=300

# Upper bound on a saved search's display name, enforced by
# propose_saved_search before a name is ever sent upstream.
# SAVED_SEARCH_NAME_MAX_LENGTH=60

# ── MCP transport ──

─────────────────────────────────────────────────────────

# "stdio" for local MCP hosts, "streamable-http" for networked mode (the
# default this server actually gets deployed with -- see server.py).
# MCP_TRANSPORT=streamable-http

# HTTP bind host/port used by FastMCP when MCP_TRANSPORT=streamable-http.
# 6001, not 6000 -- the property-search server owns 6000 and the two run
# side by side.
# MCP_HOST=0.0.0.0
# MCP_PORT=6001

# Logging verbosity: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# ── Contract tests only (make test-contract) ────────────────────────────────

# A real GuestSite bearer token for the dev environment. Required only to run
# the `contract` marked tests (tests/test_contract_*.py) -- they hit the real
# dev API and a real locally-running property-search server, never CI or the
# git hooks. Every record those tests create is deleted again in a `finally`
# block, and every name carries a `zz-contract-` prefix.
# GUESTSITE_DEV_BEARER_TOKEN=
